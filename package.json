{
  "name": "@yokostudio/space-react",
  "private": false,
  "version": "0.4.0",
  "type": "module",
  "description": "A React component library for space-themed UI components",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yokostudio/space-react.git"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "library",
    "space",
    "tailwind"
  ],
  "author": "Mahdi Hasani <mahdi.hssni@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run build:lib",
    "build:lib": "vite build --mode library",
    "build:storybook": "tsc -b tsconfig.storybook.json && storybook build -o ./docs --docs",
    "lint": "eslint . --fix",
    "storybook": "tsc -b tsconfig.storybook.json && storybook dev -p 6006",
    "chromatic": "npx chromatic --project-token=chpt_1ab15b8e62b4580",
    "prepublishOnly": "npm run build:lib",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@yokostudio/tailwind-space": "^0.3.1",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "resolutions": {
    "brace-expansion": "^2.0.2",
    "@eslint/plugin-kit": "^0.3.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.2",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-docs": "^9.1.16",
    "@storybook/addon-onboarding": "^9.1.16",
    "@storybook/react-vite": "^9.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "chromatic": "^11.29.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^9.1.16",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "postcss-import": "^15.1.0",
    "prettier": "^3.4.2",
    "storybook": "^9.1.16",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.1.2",
    "vite-plugin-svgr": "^4.5.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
